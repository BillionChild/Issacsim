        double size = 1
        float3 xformOp:scale = (0.04, 0.04, 0.81)
        double3 xformOp:translate = (-0.53, -0.53, 0.545)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

