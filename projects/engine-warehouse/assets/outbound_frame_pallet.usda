#usda 1.0
(
    defaultPrim = "Carrier"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Carrier" (
    customData = {
        string scope = "Concept only: 1.10m square, 0.95m high; open top, no pins, two support pads, fork entry from +/-Y. Restraints and forklift/truck compatibility not designed."
    }
)
{
    def "Looks"
    {
        def Material "Frame"
        {
            token outputs:surface.connect = </Carrier/Looks/Frame/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.2, 0.29, 0.36)
                float inputs:metallic = 0.7
                float inputs:roughness = 0.45
                token outputs:surface
            }
        }

        def Material "SupportPads"
        {
            token outputs:surface.connect = </Carrier/Looks/SupportPads/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.035, 0.035, 0.04)
                float inputs:metallic = 0
                float inputs:roughness = 0.45
                token outputs:surface
            }
        }
    }

    def Cube "Runner0" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Carrier/Looks/Frame>
        double size = 1
        float3 xformOp:scale = (0.12, 1.1, 0.09)
        double3 xformOp:translate = (-0.49, 0, 0.045)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "Runner1" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Carrier/Looks/Frame>
        double size = 1
        float3 xformOp:scale = (0.12, 1.1, 0.09)
        double3 xformOp:translate = (0, 0, 0.045)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "Runner2" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Carrier/Looks/Frame>
        double size = 1
        float3 xformOp:scale = (0.12, 1.1, 0.09)
        double3 xformOp:translate = (0.49, 0, 0.045)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "Deck" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Carrier/Looks/Frame>
        double size = 1
        float3 xformOp:scale = (1.1, 1.1, 0.05)
        double3 xformOp:translate = (0, 0, 0.135)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "Post00" (
