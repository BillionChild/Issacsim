            double size = 1
            float3 xformOp:scale = (0.24, 0.09, 0.015)
            double3 xformOp:translate = (0.43, -0.2, -0.5075)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }

    def Cube "LocatorPlate" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </EngineJig/Looks/Metal>
        double size = 1
        float3 xformOp:scale = (0.035, 0.34, 0.18)
        double3 xformOp:translate = (0.105, 0, -0.28)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cylinder "LocatorPinA" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        uniform token axis = "X"
        double height = 0.045
        rel material:binding = </EngineJig/Looks/Locator>
        double radius = 0.008
        double3 xformOp:translate = (0.145, -0.12, -0.28)
