            double size = 1
            float3 xformOp:scale = (0.66, 0.08, 0.08)
            double3 xformOp:translate = (0.39, -0.36, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "SideArm" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </EngineJig/Looks/Metal>
            double size = 1
            float3 xformOp:scale = (0.12, 0.08, 0.5)
            double3 xformOp:translate = (0.43, -0.36, -0.25)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "ClampShoe" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </EngineJig/Looks/Metal>
            double size = 1
            float3 xformOp:scale = (0.36, 0.1, 0.12)
            double3 xformOp:translate = (0.43, -0.285, -0.27)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "ClampPad" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </EngineJig/Looks/Rubber>
            double size = 1
            float3 xformOp:scale = (0.32, 0.015, 0.1)
            double3 xformOp:translate = (0.43, -0.2275, -0.27)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "LowerFinger" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </EngineJig/Looks/Metal>
            double size = 1
            float3 xformOp:scale = (0.3, 0.245, 0.04)
            double3 xformOp:translate = (0.43, -0.2775, -0.535)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "SupportPad" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
