#usda 1.0
(
    defaultPrim = "EngineJig"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "EngineJig" (
    customData = {
        string scope = "Custom concept, not a FANUC catalogue gripper. Placeholder locator positions, static closed pose; no verified engine hole fit."
    }
)
{
    def "Looks"
    {
        def Material "Metal"
        {
            token outputs:surface.connect = </EngineJig/Looks/Metal/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.28, 0.34, 0.42)
                float inputs:metallic = 0.7
                float inputs:roughness = 0.35
                token outputs:surface
            }
        }

        def Material "Rubber"
        {
            token outputs:surface.connect = </EngineJig/Looks/Rubber/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.025, 0.03, 0.035)
                float inputs:metallic = 0
                float inputs:roughness = 0.65
                token outputs:surface
            }
        }

        def Material "Locator"
        {
            token outputs:surface.connect = </EngineJig/Looks/Locator/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.9, 0.58, 0.08)
                float inputs:metallic = 0.65
                float inputs:roughness = 0.35
                token outputs:surface
            }
        }
    }

    def Cylinder "WristAdapter" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        uniform token axis = "X"
        double height = 0.05
        rel material:binding = </EngineJig/Looks/Metal>
        double radius = 0.115
        double3 xformOp:translate = (0.025, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cube "Backbone" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </EngineJig/Looks/Metal>
        double size = 1
        float3 xformOp:scale = (0.06, 0.12, 0.46)
        double3 xformOp:translate = (0.08, 0, -0.21)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "TopCrossbar" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </EngineJig/Looks/Metal>
        double size = 1
        float3 xformOp:scale = (0.08, 0.8, 0.08)
        double3 xformOp:translate = (0.1, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def "Left"
    {
        def Cube "TopArm" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </EngineJig/Looks/Metal>
            double size = 1
            float3 xformOp:scale = (0.66, 0.08, 0.08)
            double3 xformOp:translate = (0.39, 0.36, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "SideArm" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </EngineJig/Looks/Metal>
            double size = 1
            float3 xformOp:scale = (0.12, 0.08, 0.5)
            double3 xformOp:translate = (0.43, 0.36, -0.25)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "ClampShoe" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </EngineJig/Looks/Metal>
            double size = 1
            float3 xformOp:scale = (0.36, 0.1, 0.12)
            double3 xformOp:translate = (0.43, 0.285, -0.27)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

