#usda 1.0
(
    defaultPrim = "Conveyor"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Conveyor" (
    customData = {
        string scope = "Static layout only; no vision, motion, collision or mass. Transfer strips shown lowered."
    }
)
{
    def "Looks"
    {
        def Material "Roller"
        {
            token outputs:surface.connect = </Conveyor/Looks/Roller/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.48, 0.52, 0.57)
                float inputs:metallic = 0.8
                float inputs:roughness = 0.4
                token outputs:surface
            }
        }

        def Material "Frame"
        {
            token outputs:surface.connect = </Conveyor/Looks/Frame/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.055, 0.15, 0.26)
                float inputs:metallic = 0.5
                float inputs:roughness = 0.4
                token outputs:surface
            }
        }

        def Material "Transfer"
        {
            token outputs:surface.connect = </Conveyor/Looks/Transfer/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.045, 0.045, 0.05)
                float inputs:metallic = 0
                float inputs:roughness = 0.4
                token outputs:surface
            }
        }

        def Material "Guide"
        {
            token outputs:surface.connect = </Conveyor/Looks/Guide/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.9, 0.55, 0.06)
                float inputs:metallic = 0.3
                float inputs:roughness = 0.4
                token outputs:surface
            }
        }
    }

